   7          static uint8_t LCD_UI_WriteUnsignedLong(uint32_t value)
   8          {
   9   1          uint8_t digits[10];
  10   1          uint8_t count = 0;
  11   1          uint8_t index;
  12   1          do
  13   1          {
  14   2              digits[count++] = (uint8_t)('0' + (value % 10UL));
  15   2              value /= 10UL;
  16   2          } while (value != 0 && count < sizeof(digits));
  17   1          for (index = count; index != 0; index--) LCD_WriteChar((char)digits[index - 1]);
  18   1          return count;
  19   1      }
