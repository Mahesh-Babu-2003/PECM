 122          static uint8_t RTC_DaysInMonth(uint16_t year, uint8_t month)
 123          {
 124   1          static const uint8_t days[12] =
 125   1              {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 126   1          uint8_t count;
 127   1      
 128   1          if (month < 1 || month > 12) return 31;
 129   1          count = days[month - 1];
 130   1          if (month == 2 && ((year % 4 == 0 && year % 100 != 0) ||
 131   1              year % 400 == 0)) count = 29;
 132   1          return count;
 133   1      }
