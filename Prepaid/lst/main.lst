 582   3              }
 583   2      
 584   2              if (!rtc_edit_active && screen_switch_timer >= 2999)
 585   2              {
 586   3                  screen_switch_timer = 0;
 587   3                  lcd_page ^= 1;
 588   3                  screen_changed = 1;
 589   3                  if (lcd_page == 0)
 590   3                  {
 591   4                      lcd_values_initialized = 0;
 592   4                  }
 593   3              }
 594   2              else if (!rtc_edit_active)
 595   2              {
 596   3                  screen_switch_timer++;
 597   3              }
 598   2      
 599   2              if (lcd_page == 0)
 600   2              {
 601   3                  LCD_ShowSlaveRegisters();
 602   3              }
 603   2              else if (screen_changed || rtc_refresh_due || switch_events)
 604   2              {
 605   3                  LCD_ShowRtc();
 606   3              }
