 102          static uint8_t RTC_DaysInMonth(uint16_t year, uint8_t month)
 103          {
 104   1          static const uint8_t days[12] =
 105   1              {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 106   1          uint8_t count;
 107   1      
 108   1          if (month < 1 || month > 12) return 31;
 109   1          count = days[month - 1];
 110   1          if (month == 2 && ((year % 4 == 0 && year % 100 != 0) ||
 111   1              year % 400 == 0)) count = 29;
 112   1          return count;
 113   1      }
