 525   4                          slave_holding_registers[LOW_BALANCE_ALERT_OFFSET] != 1)
 526   4                      {
 527   5                          customer_display_screen = LCD_UI_NextCustomerScreen(
 528   5                              customer_display_screen);
 529   5                          customer_display_timer = 0;
 530   5                      }
 531   4                      if (customer_display_screen != LCD_UI_SCREEN_1_CUSTOMER_ID)
 532   4                      {
 533   5                          LCD_UI_ShowCustomerScreen(customer_display_screen);
 534   5                      }
 535   4                  }
 536   3                  else
 537   3                  {
 538   4                      customer_value_refresh_timer++;
 539   4                  }
 540   3              }
 541   2              UpdateLowBalanceBuzzer();
 542   2              Board_DelayMs(1);
 543   2          }
 544   1      }


