  35   2            case HIRC_16:
  36   2              IAPAL = 0x30;
  37   2            break;
  38   2            case HIRC_166:
  39   2              IAPAL = 0x30;
  40   2            break;
  41   2          }
  42   1          set_CHPCON_IAPEN;
  43   1          IAPAH = 0x00;
  44   1          IAPCN = READ_UID;
  45   1          set_IAPTRG_IAPGO;
  46   1          hircmap0 = IAPFD;
  47   1          IAPAL++;
