 139   2              ClockSwitch(FSYS_HIRC);
 140   2              ClockEnable(FSYS_HXTIN_P00);                 /*step1: switching system clock to External clock */
 141   2              ClockSwitch(FSYS_HXTIN_P00);
 142   2              clr_CKEN_HIRCEN;                             /*step5: disable HIRC if needed */
 143   2          break;
 144   2        }
 145   1      }
