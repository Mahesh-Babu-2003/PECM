  22   1      #elif defined __ICC8051__
                  uint8_t hircmap0, hircmap1, offset,judge;
              #elif defined __SDCC__
                  uint8_t __data hircmap0,hircmap1, offset,judge;
              #endif
  27   1          uint8_t trimvalue16bit;
