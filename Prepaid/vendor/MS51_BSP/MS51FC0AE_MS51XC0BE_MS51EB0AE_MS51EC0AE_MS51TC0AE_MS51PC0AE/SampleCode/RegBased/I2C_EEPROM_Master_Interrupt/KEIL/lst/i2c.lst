 144   1          {
 145   2              clr_I2CON_SI;
 146   2              if(I2CON&SET_BIT3)                /* Disable and re enable I2C to clear SI  */
 147   2              {
 148   3                  clr_I2CON_I2CEN;
 149   3                  set_I2CON_I2CEN;
 150   3                  clr_I2CON_SI;
 151   3              }
 152   2          }
 153   1      }
