 133          /**
 134           * @brief      I2C SI check
 135           * @param[in]  none
 136           * @return     None
 137           * @details    SI check and confirm with that SI without noise issue
 138           */
 139          void I2C0_SI_Check(void)
 140          {
 141   1          clr_I2CON_SI;
 142   1          
 143   1          while(I2CON&SET_BIT3)     /* while SI=1;  measn noise cause SI clear error. Keep clear try clear SI co
