   9          /**
  10            * @brief Timer0 delay setting
  11            * @param[in] u32SYSCLK define Fsys clock value. for example 24000000, use the real Fsys value.
  12            *                       - \ref 24000000 (use HIRC 24MHz)
  13            *                       - \ref 16000000 (use HIRC 16MHz)
  14            * @param[in] u8CNT define count time.
  15            * @param[in] u6DLYUnit define delay time base is us. From 1~10000, the maxima value please not over 1000
             -0.
  16            *                       - \ref 1000 (1ms)
  17            *                       - \ref 100 (100us)
  18            * @return  None
  19            * @note    If use LIRC or LXT as Fsys need adjust this marco.
  20            * @exmaple :  Timer0_Delay(16000000,200,1000);
  21          */
  22          void Timer0_Delay(uint32_t u32SYSCLK, uint16_t u16CNT, uint16_t u16DLYUnit)
  23          {
  24   1            uint8_t TL0TMP, TH0TMP;
  25   1      
  26   1            SFRS = 0;
  27   1            TIMER0_FSYS_DIV12;                                  //T0M=0, Timer0 Clock = Fsys/12
  28   1            ENABLE_TIMER0_MODE1;                                   //Timer0 is 16-bit mode
  29   1            TL0TMP = LOBYTE(65535-((u32SYSCLK/1000000)*u16DLYUnit/12));
  30   1            TH0TMP = HIBYTE(65535-((u32SYSCLK/1000000)*u16DLYUnit/12));
  31   1        
  32   1          while (u16CNT != 0)
  33   1          {
  34   2            TL0=TL0TMP;
  35   2            TH0=TH0TMP;
  36   2            set_TCON_TR0;                                    //Start Timer0
  37   2            while (!TF0);                       //Check Timer0 Time-Out Flag
  38   2            clr_TCON_TF0;
  39   2            clr_TCON_TR0;                       //Stop Timer0
  40   2            u16CNT --;
  41   2          }
  42   1          
  43   1            TL0  = 0; 
  44   1            TH0 = 0;
  45   1      }
  46          
