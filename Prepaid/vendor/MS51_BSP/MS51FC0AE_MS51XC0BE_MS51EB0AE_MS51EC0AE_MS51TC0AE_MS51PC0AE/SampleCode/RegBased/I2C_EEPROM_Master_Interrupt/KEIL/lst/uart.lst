  72          void UART_Open(uint32_t u32SysClock, uint8_t u8UARTPort, uint32_t u32Baudrate)
  73          {
  74   1           SFRS = 0;
  75   1           switch (u8UARTPort)
  76   1          {
  77   2              case UART0_Timer1:
  78   2                  SCON = 0x50;            //UART0 Mode1,REN=1,TI=1
  79   2                  TMOD |= 0x20;           //Timer1 Mode1
  80   2                  set_PCON_SMOD;          //UART0 Double Rate Enable
  81   2                  set_CKCON_T1M;
  82   2                  clr_T3CON_BRCK;          //Serial port 0 baud rate clock source = Timer1
  83   2                  TH1 = 256 - (u32SysClock / 16 / u32Baudrate);
  84   2                  set_TCON_TR1;
  85   2                  set_IE_ES;
  86   2                  break;
  87   2      
  88   2              case UART0_Timer3:
  89   2                  SCON = 0x50;          //UART0 Mode1,REN=1,TI=1
  90   2                  set_PCON_SMOD;        //UART0 Double Rate Enable
  91   2                  T3CON &= 0xF8;        //T3PS2=0,T3PS1=0,T3PS0=0(Prescale=1)
  92   2                  set_T3CON_BRCK;        //UART0 baud rate clock source = Timer3
  93   2                  RH3    = HIBYTE(65536 - (u32SysClock / 16 / u32Baudrate));
  94   2                  RL3    = LOBYTE(65536 - (u32SysClock / 16 / u32Baudrate));
  95   2                  set_T3CON_TR3;         //Trigger Timer3
  96   2                  set_IE_ES;
  97   2                  break;
  98   2      
  99   2              case UART1_Timer3:
 100   2                  SCON_1 = 0x50;          //UART1 Mode1,REN_1=1,TI_1=1
 101   2                  T3CON = 0x80;           //T3PS2=0,T3PS1=0,T3PS0=0(Prescale=1), UART1 in MODE 1
 102   2                  RH3    = HIBYTE(65536 - (u32SysClock/16/u32Baudrate));  
 103   2                  RL3    = LOBYTE(65536 - (u32SysClock/16/u32Baudrate));     
 104   2                  set_T3CON_TR3;             //Trigger Timer3
 105   2                  set_EIE1_ES_1;
 106   2                  break;
 107   2          }
 108   1       }
